<Window x:Class="AgentHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AgentHub"
        Width="1440" Height="900"
        MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#18181C">
    <Grid>
        <!-- 深色值只是缺省；构造时按 AppSettings.Theme 套（UI_RULES §8） -->
        <Grid x:Name="LoadingOverlay" Background="#18181C">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LoadingTitle"
                           Text="AgentHub"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingSub"
                           Text="正在启动…"
                           FontSize="13"
                           Foreground="#A8AEA9"
                           Margin="0,12,0,20"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="LoadingBar"
                             IsIndeterminate="True"
                             Width="220" Height="4"
                             BorderThickness="0"
                             Background="#101014"
                             Foreground="#2EC4B6"/>
            </StackPanel>
        </Grid>
        <wv2:WebView2 x:Name="Web"
                      Visibility="Collapsed"
                      DefaultBackgroundColor="#18181C" />
    </Grid>
</Window>
